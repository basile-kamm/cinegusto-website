{% set is_border_double = is_border_double|default(false) %}
{% set container_class = container_class|default('') %}

<div class="card p-5 {{ container_class }}">
	{% if is_border_double %}
		<div class="border border-black p-2">
		{% endif %}
		<div class="p-5 border border-black">
			{% block content %}
				<h2 class="text-xl">{{ title }}</h2>
				<p class="text-base">{{text}}</p>
			{% endblock %}
		</div>
		{% if is_border_double %}
		</div>
	{% endif %}
</div>
