{% set is_border_double = is_border_double|default(false) %}
{% set is_link = is_link|default(false) %}
{% set container_class = container_class|default('') %}
{% set padding_outside = padding_outside|default('p-3 md:p-5') %}
{% set padding = padding|default('p-3 md:p-5') %}

<div class="card {{ padding_outside }} {{ container_class }}">
	{% if is_border_double %}
		<div class="md:border md:border-black md:p-2">
		{% endif %}
		<div class="{{ padding }} border border-black">
			{% block content %}
				<h2 class="text-xl">{{ title }}</h2>
				<p class="text-base">{{text}}</p>
			{% endblock %}
		</div>
		{% if is_border_double %}
		</div>
	{% endif %}
</div>
