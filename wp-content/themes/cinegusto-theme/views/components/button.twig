{% set custom_class = custom_class|default('') %}

{% set btn_class = [
  'px-4 py-3 font-mazius inline-block font-bold text-creme transition-all duration-300 hover:scale-103 hover:-rotate-3',
  style == 'blue' ? 'bg-blue hover:bg-blue/90' : '',
  style == 'red' ? 'bg-red hover:bg-red/90' : '',
  style == 'yellow' ? 'bg-yellow hover:bg-yellow/90' : '',
  style == 'green' ? 'bg-green hover:bg-green/90' : '',
  style == 'hollow' ? 'bg-transparent border-1 border-creme text-creme outline-creme/0 outline-1 hover:outline-creme' : '',
  style == 'hollow-yellow' ? 'bg-transparent border-1 border-yellow text-yellow outline-yellow/0 outline-1 hover:outline-yellow' : '',
]|join(' ') %}


<a href="{{ href }}" class="{{ btn_class }} {{ custom_class }}">{{ text }}</a>
