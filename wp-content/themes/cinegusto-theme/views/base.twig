<!doctype html>
<!--[if lt IE 9]><html class="no-js no-svg ie lt-ie9 lt-ie8 lt-ie7" {{ site.language_attributes }}> <![endif]-->
<!--[if IE 9]><html class="no-js no-svg ie ie9 lt-ie9 lt-ie8" {{ site.language_attributes }}> <![endif]-->
<!--[if gt IE 9]><!-->
	<html
	class="no-js no-svg" {{ site.language_attributes }}> <!--<![endif]-->
	<head>
		<meta charset="{{ site.charset }}"/>
		<meta name="description" content="{{ site.description }}">
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="author" href="{{ site.theme.link }}/humans.txt"/>
		<link rel="pingback" href="{{ site.pingback_url }}"/>
		<link rel="profile" href="http://gmpg.org/xfn/11">
		<link rel="icon" type="image/png" href="{{ site.theme.link }}/assets/img/favicon/favicon-96x96.png" sizes="96x96"/>
		<link rel="icon" type="image/svg+xml" href="{{ site.theme.link }}/assets/img/favicon/favicon.svg"/>
		<link rel="shortcut icon" href="{{ site.theme.link }}/assets/img/favicon/favicon.ico"/>
		<link rel="apple-touch-icon" sizes="180x180" href="{{ site.theme.link }}/assets/img/favicon/apple-touch-icon.png"/>
		<meta name="apple-mobile-web-app-title" content="CineGusto"/>
		<link rel="manifest" href="{{ site.theme.link }}/assets/img/favicon/site.webmanifest"/>
		{{function('wp_head')}}

		{% block head %}{% endblock %}
	</head>
	<body class="{{body_class}}" data-template="base.twig" x-data>
		<div class="btn-cont fixed inset-0 z-10 pointer-events-none"></div>
		{{ function('wp_body_open') }}
		<a class="skip-link screen-reader-text" href="#content">{{ _e( 'Skip to content') }}</a>
		{% block header %}
			{% include "header.twig" %}
		{% endblock %}


		<main id="content" class="relative overflow-x-hidden">
			<div class="background {% block background_color %}bg-red{% endblock %}"></div>
			<div class="background image {% block background_image %}opacity-80{% endblock %}"></div>

			{% block content %}
				Sorry, no content
			{% endblock %}
		</main>

		{% include 'footer.twig' %}
	</body>
</html>
