{% extends "base.twig" %}

{% set days = get_f %}

{% block content %}
	<section class="banner h-[calc(100vh-64px)] flex items-center justify-center mx-10 relative ">
		{% embed 'components/card.twig'  with { padding_outside: ' p-2 md:p-3', container_class: '-rotate-3'} %}
			{% block content %}
				<div class="flex flex-col gap-4 items-center text-center">
					<h1 class="text-3xl">CinéGusto</h1>
					<p>
						Une thématique par jour, des films pour l'explorer, un menu pour la savourer.
					</p>
					<p class="text-l">Du 8 au 11 septembre 2027</p>
					<p class="text-l">Bulle - La-Tour-de-Trême</p>
				</div>
			{% endblock %}
		{% endembed %}
		<div class="absolute">
			<div class="absolute max-md:w-10 -top-35 -left-35 md:-top-30 md:-left-80 lg:-top-30 lg:-left-125 -rotate-25">
				{% include 'components/ticket.twig' %}
			</div>
			<a href="/infos" class="absolute w-18 md:w-24 lg:w-32 block -top-50 -right-45 md:-top-60 md:-right-80 lg:-top-75 lg:-right-105  rotate-12 interactive group z-1">
				<img src="{{theme_link}}/assets/img/boussole.webp" alt="" class="group-hover:scale-105 group-hover:rotate-3 transition-all duration-200 shadow-bottom">
			</a>
			<a href="/programme" class="absolute w-40 md:w-60 lg:w-80 block -bottom-80 -right-45 md:-bottom-90 md:-right-140 lg:-bottom-110 lg:-right-160 xl:-right-180 -rotate-20 interactive group z-1">
				<img src="{{theme_link}}/assets/img/menu.webp" alt="" class="group-hover:scale-105 group-hover:-rotate-3 transition-all duration-200 shadow-bottom">
			</a>
			<div class="absolute size-40 md:size-75 lg:size-85 -bottom-75 -left-50 md:-bottom-100 md:-left-140 lg:-bottom-120 lg:-left-170  shadow-bottom rotate-20">
				<img src="{{theme_link}}/assets/img/clapperboard.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute max-lg:hidden size-10 lg:size-25 -bottom-50 -left-180  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-1.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute max-lg:hidden size-10 lg:size-25 -top-30 -right-130  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-2.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute max-lg:hidden size-10 lg:size-20 -top-80 -right-60  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-3.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute size-12 md:size-20 lg:size-30 -bottom-70 -left-10 md:-bottom-90 md:-left-50 lg:-bottom-80 lg:-left-80  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-4.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute max-lg:hidden size-10 lg:size-30 -top-25 -right-165 xl:-right-190  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-5.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute size-16 md:size-20 lg:size-25 -top-50 -left-5 md:-top-60 md:-left-30 lg:-top-70 lg:-left-50  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-6.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute max-lg:hidden size-10 lg:size-60 -bottom-115 -right-85  shadow-bottom rotate-30">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-7.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute size-10 md:size-15 lg:size-20 -right-5 -bottom-50 lg:-right-40  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-8.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute size-20 md:size-30 lg:size-35 -top-0 -left-50 md:-top-10 md:-left-110 lg:-top-20 lg:-left-115 xl:-left-120 shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-9.webp" alt="" class="h-full w-full object-contain object-center rotate-70">
			</div>
			<div class="absolute size-20 md:size-30 lg:size-35 -top-72 -left-52 md:-top-70 md:-left-120 lg:-top-80 xl:-top-70 lg:-left-160 xl:-left-200 shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-10.webp" alt="" class="h-full w-full object-contain object-center ">
			</div>
			<div class="absolute max-lg:hidden size-10 lg:size-18 -bottom-20 xl:-bottom-10 -left-140 xl:-left-160  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-11.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute size-15 md:size-25 lg:size-35 -bottom-10 -right-50 md:-bottom-80 md:-right-40 lg:-bottom-110 lg:-right-10  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-12.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute size-10 md:size-15 lg:size-20 -top-60 -right-5 md:-top-70 md:-right-10 lg:-top-70 lg:-right-30  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-13.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
		</div>
		<div class="absolute size-40 md:size-60 lg:size-70 xl:size-90 origin-top-left -top-2 -right-15 md:top-0 lg:top-5 xl:-top-5 lg:-right-25  shadow-bottom">
			<img src="{{theme_link}}/assets/img/popcorn/popcorn-full.webp" alt="" class="h-full w-full object-contain object-center">
		</div>
	</section>
	<section class="grid items-start pb-50 xl:pb-80 gap-y-20 lg:gap-y-30">
		{% for thematique in thematiques %}
			<div class="relative lg:col-span-5 xl:col-span-4 odd:xl:col-start-2 odd:lg:col-start-1 even:lg:col-start-7 group interactive">
				<a href="/programme#{{thematique.theme_id}}" class="absolute inset-0 z-20"></a>
				<img src="{{ thematique.thumbnail }}" alt="" class="absolute size-30 md:size-50 bottom-0 right-0 z-10 translate-x-1/3 translate-y-1/3 lg:translate-x-1/2 lg:translate-y-1/2 group-hover:scale-104 group-hover:rotate-3 transition-transform">

				{% embed 'components/card.twig' with { is_border_double: true, container_class: 'transition-transform group-nth-1:-rotate-3 group-nth-2:rotate-3 group-nth-3:rotate-2 group-nth-4:-rotate-5 group-hover:group-nth-1:-rotate-5 group-hover:group-nth-2:rotate-5 group-hover:group-nth-3:rotate-4 group-hover:group-nth-4:-rotate-7'  } %}
					{% block content %}
						<div class="flex flex-col gap-8 lg:gap-10">
							<h2 class="text-xl font-normal">{{ thematique.theme_title }}</h2>
							<p class="text-base">{{ thematique.theme_description }}</p>
							<a href="/programme" class="text-l underline lg:hidden">Voir ce qui mijote</a>
						</div>
					{% endblock %}
				{% endembed %}
			</div>

		{% endfor %}
	</section>
	<section class="relative">
		<div class="background bg-red"></div>
		<div class="background image edelweiss opacity-20"></div>
		<div class="absolute top-0 left-0 w-full flex -translate-y-1/2 justify-center no-wrap">
			{% for i in 1..4 %}
				<div class="size-[14.14vw] shrink-0 flex items-center justify-center">
					<div class="size-[10vw] rotate-45 bg-creme"></div>
				</div>
				<div class="size-[14.14vw] shrink-0 flex items-center justify-center">
					<div class="size-[10vw] rotate-45 bg-creme p-3">
						<div class="h-full w-full border-3 border-red"></div>
					</div>
				</div>
			{% endfor %}
		</div>

		<div class="grid text-creme pt-50 pb-30">
			<h2 class="text-2xl lg:col-span-4 lg:col-start-2 ">À propos de CinéGusto</h2>
			<div class="lg:col-span-6 mt-20">
				<p class="">
					CinéGusto est le premier festival suisse à marier cinéma et gastronomie. Installé au cœur de la ville de Bulle, en Gruyère, il propose une programmation où chaque film est un voyage culinaire, et chaque repas, une extension de l'écran. Pendant quatre jours, le public est invité à explorer des récits où la nourriture est bien plus qu'un décor : elle est mémoire, résistance, passion ou héritage.
					<br>Ici, les films cultes et les pépites méconnues éveillent les sens, tandis que des chef·fe·s étoilé·e·s transforment les recettes du grand écran en expériences gustatives uniques, entre tradition et audace, pour une immersion totale où chaque détail compte.
				</p>
				<div class="flex max-md:flex-col gap-4 mt-10 items-start">
					{% include 'components/button.twig' with { text: 'En savoir plus', href: '/about', style: 'hollow' } %}
					{% include 'components/button.twig' with { text: 'Informations pratiques', href: '/infos', style: 'green' } %}
				</div>
			</div>
		</div>
	</section>
	<section class="relative spiked">
		<div class="background bg-creme"></div>
		<div class="background image opacity-10 mix-blend-plus-darker"></div>

		<div class="grid pt-50 pb-30">
			{% include 'components/vod.twig' %}
			{% include 'components/partner.twig' %}
		</div>
	</section>
	<section class="relative spiked bg-yellow grid text-blue py-25">
		<h2 class="text-2xl lg:col-span-4 lg:col-start-2 ">Newsletter</h2>
		<div class="lg:col-span-6 mt-20">
			<p class=" mb-10">
				Abonnez-vous à la newsletter pour recevoir les actualités du festival et les offres exclusives.
			</p>
			<form action="" class="flex max-md:flex-col">
				<input type="text" class="p-3 text-mazius placeholder:text-mazius! bg-creme border border-black" placeholder="Votre adresse e-mail">
				<button type="submit" class="bg-blue cursor-pointer">

					{% include 'components/button.twig' with { text: 'Tenez-moi au jus', href: "#" , style: 'blue', custom_class: 'text-yellow pointer-events-none max-md:inline-block' } %}
				</button>
			</form>
		</div>
	</section>
{% endblock %}
