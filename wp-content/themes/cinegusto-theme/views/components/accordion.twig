<div class="accordion" x-data="{ open: false }">
	<button @click="open = !open" class="flex w-full items-center gap-3 cursor-pointer" @click.outside="open = false">
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 transition-transform duration-300 shrink-0" :class="!open ? '-rotate-90' : ''">
			<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
		</svg>
		<p class="shrink-0 font-normal">{{ title }}</p>
		<div class="w-full h-1 border-b border-currentColor border-dotted"></div>
		{% block end_item %}{% endblock %}
	</button>
	<div x-show="open" x-collapse>
		<div class="gutenberg-content pl-9 mt-2 pb-3">
			{% block content %}
				{{ text }}
			{% endblock %}
		</div>
	</div>
</div>
