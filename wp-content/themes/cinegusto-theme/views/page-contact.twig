								<p class="text-l">Office du tourisme de la ville de Bulle</p>
								<p>Rue de la Gare 12</p>
								<p>1630 Bulle</p>
							</a>
							<a href="tel:+41265000000" class="text-l hover:underline">+41 (o)26 5oo oo oo</a>
						</div>
