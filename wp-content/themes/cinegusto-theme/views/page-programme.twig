{% extends "base.twig" %}

{% set days = get_f %}

{% block content %}
	<section class="banner h-[60vh] flex items-end justify-center mx-10 relative">
		{% embed 'components/card.twig'  with { padding_outside: ' p-2 md:p-3', padding: 'max-md:p-5 p-3 md:p-5', container_class: 'rotate-3'} %}
			{% block content %}
				<div class="flex flex-col gap-4 items-center text-center">
					<h1 class="text-3xl">Programme</h1>
					<p class="text-l max-md:font-normal">Du 8 au 11 septembre 2027</p>
					<p class="text-l max-md:font-normal">Bulle - La-Tour-de-Trême</p>
				</div>
			{% endblock %}
		{% endembed %}
		<div class="absolute">
			<div class="absolute max-md:w-10 -bottom-15 -right-35 md:-right-90  lg:-right-105 -rotate-25">
				{% include 'components/ticket.twig' %}
			</div>
			<a href="/infos" class="absolute w-18 md:w-24 lg:w-32 block -top-70 -left-45 md:-top-90 md:-left-70 lg:-top-95 lg:-left-85 xl:-left-95 -rotate-12 interactive group z-1" data-btn="Informations pratiques">
				<img src="{{theme_link}}/assets/img/boussole.webp" alt="" class="group-hover:scale-105 group-hover:rotate-3 transition-all duration-200 shadow-bottom">
			</a>
			<div class="absolute size-40 md:size-65 lg:size-85 -bottom-35 -left-55 md:-bottom-45 md:-left-130 lg:-bottom-60 lg:-left-160 xl:-left-190  shadow-bottom rotate-20">
				<img src="{{theme_link}}/assets/img/clapperboard.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute max-lg:hidden size-25 -top-10 -right-130  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-2.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute max-lg:hidden size-20 -top-90 -right-60  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-11.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute size-12 md:size-20 lg:size-25 -bottom-20 -left-10 md:-bottom-30 md:-left-50 lg:-bottom-25 lg:-left-50 shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-4.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute size-15 md:size-25 lg:size-30 -top-35 -right-50 md:-right-90 lg:-top-45 lg:-right-145 xl:-right-190  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-5.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute size-16 md:size-20 lg:size-25 -top-80 -left-15 md:-top-90 md:-left-30 lg:-top-103 shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-6.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute size-10 md:size-15 lg:size-20 -right-25 -top-65 md:-top-75 md:-right-35 lg:-right-80 lg:-top-60 xl:-right-100  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-8.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute size-20 md:size-30 lg:size-35 xl:size-40 -top-30 -left-50 md:-top-45 md:-left-90 lg:-top-50 lg:-left-115 xl:-left-130 xl:-top-60 shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-9.webp" alt="" class="h-full w-full object-contain object-center rotate-70">
			</div>
			<div class="absolute size-20 md:size-30 lg:size-35 -top-90 -left-52  md:-left-120 lg:-top-80 xl:-top-70 lg:-left-160 xl:-left-200 shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-10.webp" alt="" class="h-full w-full object-contain object-center ">
			</div>
			<div class="absolute max-lg:hidden size-18 -bottom-20 xl:-bottom-10 -left-20 xl:-bottom-15  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-3.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute size-15 md:size-20 lg:size-35 -bottom-10 -right-15 md:-bottom-25 md:-right-25 lg:-bottom-50 lg:-right-30  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-12.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
			<div class="absolute size-10 md:size-15 lg:size-20 -top-60 -right-5 md:-top-70 md:-right-10 lg:-top-80 lg:-right-30  shadow-bottom">
				<img src="{{theme_link}}/assets/img/seasoning/seasoning-13.webp" alt="" class="h-full w-full object-contain object-center">
			</div>
		</div>
		<div class="absolute size-40 md:size-60 lg:size-70 xl:size-90 origin-top-left -top-2 -right-15 md:top-0 lg:top-5 xl:-top-5 lg:-right-25  shadow-bottom">
			<img src="{{theme_link}}/assets/img/popcorn/popcorn-full.webp" alt="" class="h-full w-full object-contain object-center">
		</div>
	</section>
	{% for thematique in thematiques %}
		<section id="{{ thematique.theme_id}}" class="grid items-start pt-30 gap-y-10 group {{ thematique.theme_id }}">
			{% embed 'components/card.twig' with { is_border_double: true, container_class: 'lg:col-span-6 max-md:-rotate-1 group-even:-rotate-2 group-odd:rotate-1 relative z-1' } %}
				{% block content %}
					<div class="flex flex-col gap-6 lg:gap-10">
						<h2 class="text-xl">{{ thematique.theme_title }}</h2>
						<p class="text-base">{{ thematique.theme_description }}</p>
						<h3 class="text-xl font-normal">Menu du jour</h3>
						<div class="flex flex-col gap-3 md:gap-4">
							<p class="text-l">18H - Parvis de la salle CO2</p>
							<p>Cuisiné par
								<span class="text-l">{{ thematique.food_details.cooked_by }}</span>
							</p>
							<p>Menu inspriré du film
								<span class="text-l">{{ thematique.food_details.inspired_by }}</span>
							</p>
						</div>
					</div>
					<div class="flex flex-col gap-2 mt-12 lg:mt-14 mb-6 md:mb-14">
						<h4 class="text-l">Plat principal revisité</h4>
						{% include 'components/accordion.twig' with { title: thematique.food_details.main_menu.title, text: thematique.food_details.main_menu.details } %}
						<h4 class="text-l">Option végétarienne/vegan</h4>
						{% include 'components/accordion.twig' with { title: thematique.food_details.vegan_menu.title, text: thematique.food_details.vegan_menu.details  } %}
					</div>
					{% include 'components/button.twig' with { text: 'Vivre l’expérience CinéGusto', href: '/fares' , style: 'red', custom_class: 'inline-block' } %}
					<img src="{{ thematique.thumbnail }}" alt="" class="absolute size-30 md:size-70 bottom-0 right-0 z-10 translate-x-1/2 translate-y-1/2 shadow-bottom">
				{% endblock %}
			{% endembed %}

			{% embed 'components/card.twig' with { is_border_double: true, container_class: 'lg:col-span-6 lg:col-start-7 max-md:rotate-1 group-even:rotate-1 group-odd:-rotate-3 mt-10' } %}
				{% block content %}
					<div class="flex flex-col gap-8 lg:gap-10">
						<h2 class="text-xl font-normal">Séances du jour</h2>
						<div class="flex flex-col gap-8">
							{% for session in thematique.films_details %}
								<div class="flex flex-col gap-4">
									<h4 class="text-l">{{ session.time }}</h4>
									{% for film in session.films %}
										{% set film_term = get_fields('film_' ~ film.film_object) %}
										{% embed 'components/accordion.twig' with { title: film_term.film_title } %}
											{% block end_item %}
												<p class="shrink-0 max-md:hidden">{{ film.place }}</p>
											{% endblock %}
											{% block content %}
												<div class="flex flex-col gap-4 items-start">
													<div class="flex gap-4 md:gap-6">
														<p class="text-l">{{ film_term.film_author }}</p>
														<p>{{ film_term.place_and_date }}</p>
													</div>
													<p class="font-bold">{{ film.place }}</p>
													<div class="flex gap-4 md:gap-6">
														<p>{{ film_term.film_duration }}</p>
														<p>{{ film_term.film_type }}</p>
														<p>{{ film_term.minimal_age ? film_term.minimal_age : 'Tout public' }}</p>
													</div>
													<div class="w-full">
														<iframe class="w-full aspect-video" data-embed="{{ film_term.embed_link}}" x-ref="iframe" src="" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
													</div>
													<p>{{ film_term.film_synopsis }}</p>
													{% include 'components/button.twig' with { text: 'Croquer un billet', href: '/fares' , style: 'red', custom_class: 'mt-4' } %}
												</div>
											{% endblock %}
										{% endembed %}
									{% endfor %}
								</div>
							{% endfor %}
						</div>
					</div>
				{% endblock %}
			{% endembed %}
		</section>
	{% endfor %}
	<div class="mb-20 lg:mb-40"></div>
	<section class="relative spiked text-yellow">
		<div class="background bg-blue "></div>
		<div class="background image opacity-15 mix-blend-color-burn"></div>

		<div class="grid pt-30 lg:pt-50 pb-30">
			<h2 class="text-2xl lg:col-span-4 lg:col-start-2 ">Intéressé·e ?</h2>
			<div class="lg:col-span-4 mt-10 lg:mt-15">
				<p class=" mb-10">
					Découvrez nos formules adaptées à chacunes de vos envies !
				</p>
				{% include 'components/button.twig' with { text: 'Croquez nos tarifs', href: '/fares' , style: 'yellow', custom_class: 'text-blue!' } %}
			</div>

		</div>
	</section>
	<section class="relative spiked">
		<div class="background bg-creme"></div>
		<div class="background image opacity-10 mix-blend-plus-darker"></div>

		<div class="grid pt-50 pb-30 canap-container">
			{% include 'components/vod.twig' %}
		</div>
	</section>
{% endblock %}
